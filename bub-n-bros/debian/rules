#!/usr/bin/make -f
# Three binary packages (they conflict with each other): bubbros-python,
# bubbros-server-portable and bubbros-portable.  The build and the
# installation are shared with the Arch and RPM packages:
# packing/linux/build.sh and packing/linux/install.sh.
# Needs network access while building: cargo downloads the Rust
# client's dependencies (unless vendored with "cargo vendor" in
# rust-client/), and pip installs PyInstaller (unless PYINSTALLER_PYTHON
# names a Python that has it).

export DH_VERBOSE = 1
export PYTHON = python3
export CARGO_HOME = $(CURDIR)/debian/cargo-home

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	sh packing/linux/build.sh

override_dh_auto_test:

override_dh_auto_install:
	NO_COMPILE=1 sh packing/linux/install.sh python $(CURDIR)/debian/bubbros-python
	sh packing/linux/install.sh server-portable $(CURDIR)/debian/bubbros-server-portable
	sh packing/linux/install.sh portable $(CURDIR)/debian/bubbros-portable

# the PyInstaller program carries its own Python libraries
override_dh_shlibdeps:
	dh_shlibdeps -Xbubnbros-server

override_dh_auto_clean:
	rm -rf display/build display/xshm*.so bubbob/build debian/cargo-home
	rm -rf rust-client/target packing/linux/out packing/pyinstaller/build packing/pyinstaller/dist
	$(MAKE) -C doc clean || true
	find . -name __pycache__ -prune -exec rm -rf {} +
