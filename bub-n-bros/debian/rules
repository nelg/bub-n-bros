#!/usr/bin/make -f
# The build and the installation are shared with the RPM package:
# packing/linux/build.sh and packing/linux/install.sh.
# The native client's Rust dependencies are downloaded by cargo unless
# they were vendored first ("cargo vendor" in rust-client/).

export DH_VERBOSE = 1
export PYTHON = python3
export CARGO_HOME = $(CURDIR)/debian/cargo-home

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	sh packing/linux/build.sh

override_dh_auto_test:

override_dh_auto_install:
	NO_COMPILE=1 sh packing/linux/install.sh $(CURDIR)/debian/bubbros

override_dh_auto_clean:
	rm -rf display/build display/xshm*.so bubbob/build debian/cargo-home
	rm -rf rust-client/target
	$(MAKE) -C doc clean || true
	find . -name __pycache__ -prune -exec rm -rf {} +
