# The 'statesaver' extension copies running generators, which is only
# possible with the Python 2 C API.  Without it the game simply has no
# clock bonus, so there is nothing to build for Python 3.
all:
	@echo "Note: the 'statesaver' extension (clock bonus) is not available on Python 3; skipped."

statesaver.so: statesaver.c
	@echo "Note: the 'statesaver' extension (clock bonus) is not available on Python 3; skipped."
